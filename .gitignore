# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Lint / type-check caches
.ruff_cache/
.mypy_cache/
.pyright/
.bandit
dmypy.json

# Local instance / runtime data (DB, sessions, cache)
instance/
*.sqlite
*.db

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Environment / secrets — never commit real secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
